{
  "Comment": "Reference copy of the least-privilege task-role policy. The authoritative version is generated by main.tf (aws_iam_policy_document.task). This file is kept in sync for documentation and for anyone applying IAM by hand instead of via Terraform. Replace ACCOUNT id and bucket name if they differ.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSensorAndNeighborTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Query",
        "dynamodb:GetItem",
        "dynamodb:Scan"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:975048338421:table/WS_*",
        "arn:aws:dynamodb:us-east-1:975048338421:table/SSMet_*",
        "arn:aws:dynamodb:us-east-1:975048338421:table/gateway-prediction"
      ]
    },
    {
      "Sid": "WriteBackReconstructedToSourceTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:BatchWriteItem",
        "dynamodb:PutItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:975048338421:table/WS_*",
        "arn:aws:dynamodb:us-east-1:975048338421:table/SSMet_*"
      ]
    },
    {
      "Sid": "WriteIncrementalMetadata",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:975048338421:table/WS_Reconstruction_Metadata"
    },
    {
      "Sid": "S3PutOptionalDebugOutputOnly",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::annam-reconstructed/*"
    }
  ]
}

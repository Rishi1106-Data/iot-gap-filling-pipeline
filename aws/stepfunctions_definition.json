{
  "Comment": "Annam AI gap-filling: discover active sensors, batch them, fan out to Fargate Spot (one task per batch, many sensors per task), with retries and failure notification.",
  "StartAt": "DiscoverAndBatch",
  "States": {
    "DiscoverAndBatch": {
      "Type": "Task",
      "Comment": "Runs aws/list_sensors.py on Fargate. Reads ACTIVE sensors from DynamoDB and emits batch descriptors. Lightweight (no ML deps used).",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "Cluster": "${EcsClusterArn}",
        "TaskDefinition": "${ListSensorsTaskDefArn}",
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ["${PrivateSubnet1}", "${PrivateSubnet2}"],
            "SecurityGroups": ["${TaskSecurityGroup}"],
            "AssignPublicIp": "DISABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "list-sensors",
              "Command": ["python", "aws/list_sensors.py"],
              "Environment": [
                { "Name": "RUN_ID", "Value.$": "$$.Execution.Name" },
                { "Name": "RUN_DATE", "Value.$": "States.ArrayGetItem(States.StringSplit($$.Execution.StartTime, 'T'), 0)" }
              ]
            }
          ]
        }
      },
      "ResultPath": "$.discovery",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed", "ECS.AmazonECSException"],
          "IntervalSeconds": 10,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "NotifyFailure" }
      ],
      "Next": "LoadBatches"
    },

    "LoadBatches": {
      "Type": "Task",
      "Comment": "DiscoverAndBatch wrote batches to stdout; in production a small Lambda reads them from the ECS task's CloudWatch log or, preferably, list_sensors writes batches to S3 and this step loads them. We load from S3 here.",
      "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
      "Parameters": {
        "Bucket": "${DataBucket}",
        "Key.$": "States.Format('runs/{}/batches.json', $$.Execution.Name)"
      },
      "ResultSelector": {
        "batches.$": "States.StringToJson($.Body)"
      },
      "ResultPath": "$.loaded",
      "Retry": [
        { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 5, "MaxAttempts": 3, "BackoffRate": 2.0 }
      ],
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "NotifyFailure" }
      ],
      "Next": "ProcessBatches"
    },

    "ProcessBatches": {
      "Type": "Map",
      "Comment": "Fan out: one Fargate Spot task PER BATCH. Each task processes BATCH_SIZE sensors sequentially. MaxConcurrency caps parallel tasks to protect DynamoDB/S3 and control spend.",
      "ItemsPath": "$.loaded.batches.batches",
      "MaxConcurrency": 20,
      "ItemSelector": {
        "device_ids.$": "$$.Map.Item.Value.device_ids",
        "batch_id.$": "$$.Map.Item.Value.batch_id",
        "run_id.$": "$$.Execution.Name",
        "run_date.$": "States.ArrayGetItem(States.StringSplit($$.Execution.StartTime, 'T'), 0)"
      },
      "ItemProcessor": {
        "ProcessorConfig": { "Mode": "DISTRIBUTED", "ExecutionType": "STANDARD" },
        "StartAt": "RunBatch",
        "States": {
          "RunBatch": {
            "Type": "Task",
            "Resource": "arn:aws:states:::ecs:runTask.sync",
            "Parameters": {
              "Cluster": "${EcsClusterArn}",
              "TaskDefinition": "${RunBatchTaskDefArn}",
              "LaunchType": "FARGATE",
              "CapacityProviderStrategy": [
                { "CapacityProvider": "FARGATE_SPOT", "Weight": 4 },
                { "CapacityProvider": "FARGATE", "Weight": 1, "Base": 0 }
              ],
              "NetworkConfiguration": {
                "AwsvpcConfiguration": {
                  "Subnets": ["${PrivateSubnet1}", "${PrivateSubnet2}"],
                  "SecurityGroups": ["${TaskSecurityGroup}"],
                  "AssignPublicIp": "DISABLED"
                }
              },
              "Overrides": {
                "ContainerOverrides": [
                  {
                    "Name": "run-batch",
                    "Command": ["python", "aws/run_batch.py", "--batch-json.$", "States.JsonToString($)"],
                    "Environment": [
                      { "Name": "RUN_ID", "Value.$": "$.run_id" },
                      { "Name": "RUN_DATE", "Value.$": "$.run_date" }
                    ]
                  }
                ]
              }
            },
            "Retry": [
              {
                "Comment": "Fargate Spot interruptions surface as TaskFailed/Stopped; retry on a different capacity slot.",
                "ErrorEquals": ["States.TaskFailed", "ECS.AmazonECSException", "States.Timeout"],
                "IntervalSeconds": 30,
                "MaxAttempts": 3,
                "BackoffRate": 2.0
              }
            ],
            "Catch": [
              {
                "Comment": "A whole batch failing after retries is recorded but does NOT abort the Map — other batches keep running.",
                "ErrorEquals": ["States.ALL"],
                "ResultPath": "$.batchError",
                "Next": "BatchFailed"
              }
            ],
            "End": true
          },
          "BatchFailed": {
            "Type": "Pass",
            "Parameters": { "status": "failed", "batch_id.$": "$.batch_id", "error.$": "$.batchError" },
            "End": true
          }
        }
      },
      "ResultPath": "$.mapResults",
      "Next": "Summarize"
    },

    "Summarize": {
      "Type": "Pass",
      "Comment": "Terminal success state. ToleratedFailurePercentage on the Map (set via API) governs whether partial batch failures fail the run.",
      "End": true
    },

    "NotifyFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${FailureTopicArn}",
        "Subject": "Annam gap-filling pipeline FAILED",
        "Message.$": "States.Format('Execution {} failed. Error: {}', $$.Execution.Name, $.error)"
      },
      "Next": "FailState"
    },

    "FailState": {
      "Type": "Fail",
      "Error": "PipelineFailed",
      "Cause": "See SNS notification and CloudWatch logs."
    }
  }
}

{
  "family": "annam-list-sensors",
  "comment": "Lightweight discovery/batching step. No ML deps exercised; smallest Fargate size. Could be a Lambda, but reusing the same image avoids a second artifact and keeps boto3 versions identical.",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::${AccountId}:role/annam-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::${AccountId}:role/annam-gapfill-task-role",
  "containerDefinitions": [
    {
      "name": "list-sensors",
      "image": "${AccountId}.dkr.ecr.${Region}.amazonaws.com/annam-gapfill:${ImageTag}",
      "essential": true,
      "command": ["python", "aws/list_sensors.py"],
      "environment": [
        { "name": "AWS_REGION", "value": "${Region}" },
        { "name": "DATA_BUCKET", "value": "${DataBucket}" },
        { "name": "SENSOR_TABLE", "value": "annam-sensor-metadata" },
        { "name": "RESULTS_TABLE", "value": "annam-gapfill-results" },
        { "name": "CW_NAMESPACE", "value": "AnnamAI/GapFilling" },
        { "name": "METRICS_MODE", "value": "emf" },
        { "name": "BATCH_SIZE", "value": "25" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/annam-list-sensors",
          "awslogs-region": "${Region}",
          "awslogs-stream-prefix": "discover",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
